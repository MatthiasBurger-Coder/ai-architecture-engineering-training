{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "call_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z_]+$"
    },
    "arguments": {
      "type": "object"
    }
  },
  "required": [
    "call_id",
    "name",
    "arguments"
  ],
  "additionalProperties": false
}
