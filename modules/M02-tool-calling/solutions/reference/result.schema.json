{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "call_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "const": "ok"
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "call_id",
        "status",
        "data"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "call_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "status": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "call_id",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
